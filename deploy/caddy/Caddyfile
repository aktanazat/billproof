# Caddy writes no access log, but its warnings and errors carry the request, visitor address included; the address is
# dropped from every message (owner approval 2026-11-27 to keep no visitor address past its hour).
{
	log default {
		format filter {
			wrap json
			request>remote_ip delete
			request>client_ip delete
			request>headers>X-Forwarded-For delete
		}
	}
}

billproof.aktan.us {
	encode {
		zstd
		gzip
		match {
			header Content-Type text/*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
		}
	}
	request_body {
		max_size 41MB
	}
	# Standard protections that can't break the demo. Framing is left allowed, in case the judges' site embeds it.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	reverse_proxy app:3000 {
		# The check streams Muse Ember's reading line by line; pass each line through as it arrives.
		flush_interval -1
		# A deploy replaces the app's container; a request arriving while it starts waits for it instead of failing.
		# Only a refused connection is retried, so a check already sent is never sent twice.
		lb_try_duration 15s
		lb_try_interval 250ms
	}
}
