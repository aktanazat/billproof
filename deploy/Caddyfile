billproof.aktan.us {
	encode {
		zstd
		gzip
		match {
			header Content-Type text/*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
		}
	}
	request_body {
		max_size 41MB
	}
	reverse_proxy app:3000 {
		# The check streams Muse Ember's reading line by line; pass each line through as it arrives.
		flush_interval -1
	}
}
